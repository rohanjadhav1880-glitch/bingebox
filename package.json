{
  "name": "video-player",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron ."
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "lucide": "^1.21.0"
  }
}
